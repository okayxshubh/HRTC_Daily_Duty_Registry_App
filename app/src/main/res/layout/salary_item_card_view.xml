<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/completeCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/customborder_dialog"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <!-- 💰 Image -->

        <!-- 🔤 Title -->
        <ImageView
            android:id="@+id/imageViewEstablishment"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerInside"
            android:src="@drawable/rupee"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.454" />

        <TextView
            android:id="@+id/head_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="SALARY ABC"
            android:textColor="@color/blue"
            android:textSize="18sp"
            android:textStyle="bold"
            android:typeface="sans"
            app:layout_constraintStart_toEndOf="@+id/imageViewEstablishment"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="10dp" />

        <!-- 📌 Sector (Hidden) -->
        <TextView
            android:id="@+id/sector"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Sector Info"
            android:textSize="14sp"
            android:textColor="#366988"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@+id/head_tv"
            app:layout_constraintTop_toBottomOf="@+id/head_tv"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 🔹 Second Text -->

        <!-- 🏠 Third Text -->

        <TextView
            android:id="@+id/second_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Registration Number"
            android:textColor="@color/darkblue"
            android:textSize="14sp"
            android:layout_marginStart="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toEndOf="@+id/imageViewEstablishment"
            app:layout_constraintTop_toBottomOf="@+id/head_tv" />

        <TextView
            android:id="@+id/third_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Address"
            android:textSize="14sp"
            android:textColor="@color/darkblue"
            app:layout_constraintTop_toBottomOf="@+id/second_tv"
            app:layout_constraintStart_toStartOf="@+id/second_tv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
