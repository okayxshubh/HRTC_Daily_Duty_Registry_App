<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hrtc_home_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Info CardView with Logo and Description -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/customborder_dialog"
            android:elevation="4dp"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="HRTC Daily Duty Registry Application"
                    android:textColor="@color/green"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>


        <!-- Main Card View -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:background="@drawable/customborder_dialog"
            android:elevation="5dp"
            app:cardCornerRadius="20dp"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp"
                android:radius="10dp">


                <!-- Logo and Title Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="5dp">

                    <!-- App Logo -->
                    <ImageView
                        android:id="@+id/logoImageView"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="20dp"
                        android:contentDescription="App Logo"
                        android:padding="10dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/hrtc" />


                    <!-- Title -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="20dp"
                        android:fontFamily="@font/raleway_semibold"
                        android:text="Login HRTC"
                        android:textAlignment="center"
                        android:textAllCaps="true"
                        android:textColor="@color/hrtc_green"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>


                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/loginTabLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:tabGravity="fill"
                    app:tabIndicatorColor="@color/green"
                    app:tabMode="fixed"
                    app:tabSelectedTextColor="@color/green"
                    app:tabTextColor="@color/gray">

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OTP Login" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Password Login" />

                </com.google.android.material.tabs.TabLayout>


                <!-- OTP -->
                <LinearLayout
                    android:id="@+id/OTPLoginLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:padding="5dp">

                    <!-- Username Input with TextInputLayout -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:gravity="start"
                        android:textColor="@color/hrtc_green"
                        android:textColorHint="@color/hrtc_green"
                        app:passwordToggleEnabled="false">


                        <EditText
                            android:id="@+id/mobileNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:layout_marginBottom="10dp"
                            android:hint="Mobile Number"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:maxLength="10"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="#3F51B5"
                            android:textColorHint="#4CAF50"
                            android:textSize="15sp"
                            app:hintTextAppearance="@style/CustomTextHintStyle" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- OTP -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/enterOTPLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:gravity="start"
                        android:textColor="@color/hrtc_green"
                        android:textColorHint="@color/hrtc_green"
                        app:passwordToggleEnabled="false">


                        <EditText
                            android:id="@+id/otpTV"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:layout_marginBottom="10dp"
                            android:hint="Enter OTP"
                            android:imeOptions="actionNext"
                            android:maxLength="6"
                            android:inputType="number"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="#3F51B5"
                            android:textColorHint="#4CAF50"
                            android:textSize="15sp"
                            app:hintTextAppearance="@style/CustomTextHintStyle" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.doi.spinnersearchable.SearchableSpinner
                        android:id="@+id/emails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="30dp"
                        android:layout_margin="10dp"
                        android:background="@drawable/customborder_dialog"
                        android:textColor="@color/blue"
                        android:visibility="gone" />


                    <Button
                        android:id="@+id/getOtp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/customborder_dialog_green"
                        android:elevation="2dp"
                        android:paddingVertical="12dp"
                        android:text="Get OTP"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="16sp" />

                    <!-- Login Button -->
                    <Button
                        android:id="@+id/validateOTP"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/customborder_dialog_green"
                        android:elevation="2dp"
                        android:paddingVertical="12dp"
                        android:text="Validate and Login"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="16sp" />

                </LinearLayout>

                <!-- PASS -->
                <LinearLayout
                    android:id="@+id/PassLoginLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:visibility="gone"
                    android:orientation="vertical"
                    android:padding="5dp">

                    <!-- Username Input with TextInputLayout -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:gravity="start"
                        android:textColor="@color/hrtc_green"
                        android:textColorHint="@color/hrtc_green"
                        app:passwordToggleEnabled="false">


                        <AutoCompleteTextView
                            android:id="@+id/userName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:layout_marginBottom="10dp"
                            android:hint="Username"
                            android:imeOptions="actionNext"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="#3F51B5"
                            android:textColorHint="#4CAF50"
                            android:textSize="15sp"
                            app:hintTextAppearance="@style/CustomTextHintStyle" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password Input with Eye Icon -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:gravity="start"
                        android:textColor="@color/hrtc_green"
                        android:textColorHint="@color/hrtc_green"
                        app:passwordToggleEnabled="true">

                        <EditText
                            android:id="@+id/password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:layout_marginBottom="10dp"
                            android:hint="Enter  Password"
                            android:imeOptions="actionNext"
                            android:inputType="textPassword"
                            android:singleLine="true"
                            android:textColor="#3F51B5"
                            android:textColorHint="#4CAF50"
                            android:textSize="15sp"
                            app:hintTextAppearance="@style/CustomTextHintStyle" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Login Button -->
                    <Button
                        android:id="@+id/signIn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/customborder_dialog_green"
                        android:elevation="2dp"
                        android:paddingVertical="12dp"
                        android:text="Login"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="16sp" />
                </LinearLayout>


                <!-- Forgot -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginEnd="10dp"
                        android:fontFamily="@font/raleway_semibold"
                        android:gravity="right"
                        android:text="Issue in login?"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/forgotPassBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_removed"
                        android:fontFamily="@font/raleway_semibold"
                        android:shadowRadius="@integer/material_motion_duration_short_2"
                        android:text="Visit HimAccess"
                        android:textColor="@color/hrtc_green"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:ignore="TextSizeCheck" />

                </LinearLayout>


            </LinearLayout>

        </androidx.cardview.widget.CardView>


    </LinearLayout>

</ScrollView>
